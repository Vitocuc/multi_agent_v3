# =============================================================================
# Local Development Environment Variables — ProtegoPay
# =============================================================================
# Copy this file to infra/.env (gitignored) and fill in values for local dev.
# NEVER commit infra/.env — it is gitignored.
# In production, ALL secrets come from AWS Secrets Manager, not .env files.
# =============================================================================

# AWS credentials — use IAM roles in CI/CD and EC2/ECS. Only for local dev.
# Prefer: aws configure --profile protegopay-dev
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-central-1

# Terraform workspace (dev / staging / prod)
# TF_WORKSPACE=dev

# Override for local application testing only — not used in AWS deployments
# DATABASE_URL=postgresql://protegopay_admin:REPLACE@localhost:5432/protegopay_dev
# REDIS_URL=redis://:REPLACE@localhost:6379/0
# JWT_SECRET=REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS
# WEBHOOK_HMAC_SECRET=REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS
