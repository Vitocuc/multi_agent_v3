# ============================================================
# Protego Life Simulator — Environment Variable Template
# ============================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or .env — they are in .gitignore.
# All production secrets are injected via Railway environment variables.
# ============================================================

# ── Database (PostgreSQL + TimescaleDB) ─────────────────────
# Local: use docker-compose.dev.yml — service named 'db'
# Railway: set DATABASE_URL in the Next.js service env section
DATABASE_URL=postgresql://protego:protego_pass@localhost:5432/protego

# ── Redis (session store) ───────────────────────────────────
# Local: use docker-compose.dev.yml — service named 'redis'
REDIS_URL=redis://localhost:6379

# ── NextAuth.js ─────────────────────────────────────────────
# NEXTAUTH_URL: the public URL of the Next.js app
NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET: generate with: openssl rand -base64 32
# Railway: store as a secret environment variable — NEVER hardcode
NEXTAUTH_SECRET=replace_with_openssl_rand_base64_32_output

# ── Google OAuth (obtained from Google Cloud Console) ───────
# Store client ID and secret in Railway environment variables.
# Never commit real values here.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── FastAPI Event Service ───────────────────────────────────
# Local: http://localhost:8000
# Railway: internal network URL (http://events.railway.internal:8000)
NEXT_PUBLIC_EVENT_API_URL=http://localhost:8000

# ── Node environment ────────────────────────────────────────
NODE_ENV=development

# ── FastAPI service (set in Railway for the events service) ─
# DATABASE_URL is shared — same value as above
# ALLOWED_ORIGINS: comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000
