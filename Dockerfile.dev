# Development Dockerfile for Next.js
# For production, use multi-stage build with output: 'standalone'
FROM node:20-slim

WORKDIR /app

# Install dependencies first for layer caching
COPY package*.json ./
RUN npm ci

# Copy source
COPY . .

# Generate Prisma client
RUN npx prisma generate

EXPOSE 3000

CMD ["npm", "run", "dev"]
