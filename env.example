# Copy to .env and fill in your keys. Never commit .env.
# Shell environment variables always take precedence over values here.

# Required: model API keys
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Required for gh CLI (opening PRs from Docker container)
GITHUB_TOKEN=

# Optional: override default models
# CLAUDE_MODEL=claude-sonnet-4-20250514
# GEMINI_MODEL=gemini-2.5-flash

# Optional: override default model roles
# CTO_MODEL=claude        # claude | gemini
# VALIDATOR_MODEL=gemini  # claude | gemini

# Optional: override Docker test image name (default: dev-assistant-test)
# TEST_IMAGE=dev-assistant-test
